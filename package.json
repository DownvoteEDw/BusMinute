{
  "name": "busminute",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Horaires GTFS multi-opérateurs et suivi SIRI-Lite pour BlaBlaCar Bus et FlixBus",
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "build": "next build --webpack",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "vitest run --exclude \"blablabus-core/**\"",
    "check": "npm run build:core && npm run test && npm run build",
    "match": "npm run build:core --silent && node dist/src/cli/match.js",
    "db:migrate": "npm run build:core --silent && node dist/src/cli/migrate.js",
    "db:import-gtfs": "npm run build:core --silent && node dist/src/cli/import-gtfs.js",
    "db:sync": "npm run build:core --silent && node dist/src/cli/sync-worker.js",
    "worker": "node dist/src/cli/sync-worker.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "csv-parse": "^6.1.0",
    "luxon": "^3.7.2",
    "next": "16.3.2",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
